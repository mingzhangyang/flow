{
  "//": "类型检查纯逻辑层（src/domain, src/runtime）。与 Expo 应用的 tsconfig.json 分离，避免 bundler 冲突。用 node --test 直接运行 .ts，因此要求可擦除语法与显式 .ts import。",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "module": "preserve",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts"],
  "//exclude": "以下适配器引用原生模块（RN/Expo），由应用侧 tsconfig.json 检查，不进入 node 端检查。",
  "exclude": ["src/**/*.native.ts", "src/storage/asyncStorageKv.ts", "src/storage/secureKv.ts", "src/sharing/systemSharer.ts", "src/ui"]
}
